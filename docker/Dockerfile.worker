# ---- Worker (Trigger.dev + Event Consumer) ----
FROM node:20-alpine AS base

RUN apk add --no-cache libc6-compat tesseract-ocr tesseract-ocr-data-eng
WORKDIR /app

COPY package.json tsconfig.json trigger.config.ts ./
RUN npm install --omit=dev

COPY src/ ./src/
COPY trigger/ ./trigger/
COPY sql/ ./sql/

RUN npm run build

# ---- Runtime ----
FROM node:20-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-eng

COPY package.json ./
COPY --from=base /app/dist ./dist
COPY --from=base /app/node_modules ./node_modules

RUN mkdir -p uploads

CMD ["sh", "-c", "node dist/workers/event-consumer.js & npx trigger.dev@latest dev"]
